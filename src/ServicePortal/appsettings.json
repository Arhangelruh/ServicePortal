{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NLog": {
    "targets": {
      "file": {
        "type": "File",
        "fileName": "D:\\test\\logs\\app-${date:format=yyyy-MM-dd}.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message} ${exception}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "file"
      }
    ]
  },
  "Services": [
    {
      "Id": "home",
      "Name": "Главная",
      "Url": "URL",
      "Icon": "/images/Home.svg"
    },
    {
      "Id": "monitor",
      "Name": "Монитор курсов",
      "Url": "URL",
      "Icon": "/images/Coins.svg"
    }
  ]
}
